# Read only by Node. Keep actual secrets in server/.env or hosting secrets.
OPENAI_API_KEY=replace_with_provider_key
OPENAI_MODEL=gpt-4.1-mini
# Local development only. Generate: openssl rand -hex 32
BACKEND_ACCESS_TOKEN=replace_with_random_64_character_token
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8787
# Production: NODE_ENV=production, HOST=0.0.0.0, personal invitations only.
# Generate each invitation using: node server/invite.mjs
INVITE_TOKEN_HASHES=
PER_TESTER_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=300
REQUESTS_PER_MINUTE=20
# Production must point to a writable persistent disk (one server instance).
# USAGE_FILE=/data/usage.json
